cabal-version: 3.0
name: native-oracle
version: 0.1.0.0
build-type: Simple

executable native-oracle
  main-is: Main.hs
  default-language: Haskell2010
  build-depends:
    base >= 4.20 && < 4.22,
    aeson,
    attoparsec,
    base16-bytestring,
    cardano-api == 11.6.0.0,
    cardano-binary,
    bytestring,
    cryptonite,
    memory,
    text,
    cardano-crypto-class == 2.5.1.0,
    ouroboros-network:framework,
    kes-agent == 1.3.0.0,
    kes-agent-crypto == 1.1.0.0,
    unix
